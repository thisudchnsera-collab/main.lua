-- Helper function for styling buttons (Black buttons, white text, sharp edges)
local function styleButton(btn)
    btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15) -- Black Button
    btn.Font = Enum.Font.SourceSans
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 3) -- เหลี่ยมๆ
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 255) -- Cyan stroke option if wanted, or leave clean
    stroke.Thickness = 1
    stroke.Transparency = 0.5
    stroke.Parent = btn
end

