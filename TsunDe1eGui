local bangMode = false
local sitBangMode = false
local headShotMode = false
local mehMode = false
local storedShoulderC0 = nil

local function resetArm()
    local char = LocalPlayer.Character
    if char then
        pcall(function()
            local shoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
            if shoulder and storedShoulderC0 then
                shoulder.C0 = storedShoulderC0
            end
        end)
    end
    storedShoulderC0 = nil
end

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    local rawSpeed = tonumber(SpeedBox.Text) or 25
    local speed = math.clamp(rawSpeed, 1, 150)
    
    if bangMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        if humanoid then humanoid.Sit = false end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.2 + math.sin(tick() * speed) * 0.8)
    elseif sitBangMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        if humanoid then humanoid.Sit = true end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -0.5, -1 + math.sin(tick() * speed) * 0.8) * CFrame.Angles(math.rad(90), 0, 0)
    elseif headShotMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        if humanoid then humanoid.Sit = false end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0.8, 1.5, 1.2)
        pcall(function()
            local shoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
            if shoulder then
                if not storedShoulderC0 then storedShoulderC0 = shoulder.C0 end
                shoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(120 + math.sin(tick() * speed) * 40), 0, 0)
            end
        end)
    elseif mehMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        if humanoid then humanoid.Sit = false end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(1.2, 0.5, 1.2)
        pcall(function()
            local shoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
            if shoulder then
                if not storedShoulderC0 then storedShoulderC0 = shoulder.C0 end
                shoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(70), 0, math.rad(math.sin(tick() * speed) * 45))
            end
        end)
    end
end)

