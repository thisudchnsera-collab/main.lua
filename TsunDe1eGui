    if tick() - holdTime < holdThreshold then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-------------------------------------------------
-- 3. Sound System
-------------------------------------------------
local SoundLabel = Instance.new("TextLabel")
SoundLabel.Size = UDim2.new(0.9, 0, 0, 25)
SoundLabel.Position = UDim2.new(0.05, 0, 0.22, 0)
SoundLabel.BackgroundTransparency = 1
SoundLabel.Text = "Volume Level (1 - 10000):"
SoundLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
SoundLabel.TextSize = 13
SoundLabel.Font = Enum.Font.GothamBold
SoundLabel.TextXAlignment = Enum.TextXAlignment.Left
SoundLabel.Parent = MainFrame

local VolumeBox = Instance.new("TextBox")
VolumeBox.Size = UDim2.new(0.9, 0, 0, 38)
VolumeBox.Position = UDim2.new(0.05, 0, 0.32, 0)
VolumeBox.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
VolumeBox.BorderSizePixel = 0
VolumeBox.Text = "100"
VolumeBox.TextColor3 = Color3.fromRGB(0, 255, 255)
VolumeBox.TextSize = 15
VolumeBox.Font = Enum.Font.GothamBold
VolumeBox.PlaceholderText = "1 - 10000"
VolumeBox.Parent = MainFrame

local BoxStroke = Instance.new("UIStroke")
BoxStroke.Color = Color3.fromRGB(0, 255, 255)
BoxStroke.Thickness = 1
BoxStroke.Parent = VolumeBox

VolumeBox:GetPropertyChangedSignal("Text"):Connect(function()
    local num = tonumber(VolumeBox.Text)
    if VolumeBox.Text ~= "" then
        if not num then
            VolumeBox.Text = VolumeBox.Text:gsub("%D", "")
        elseif num > 10000 then
            VolumeBox.Text = "10000"
        elseif num < 1 and VolumeBox.Text ~= "0" then
            VolumeBox.Text = "1"
        end
    end
end)

local TrollSound = Instance.new("Sound")
TrollSound.Name = "TsunDe1eTrollSound"
TrollSound.SoundId = "rbxassetid://" .. SOUND_ID
TrollSound.Volume = 1
TrollSound.Looped = true

local PlayBtn = Instance.new("TextButton")
PlayBtn.Size = UDim2.new(0.9, 0, 0, 45)
PlayBtn.Position = UDim2.new(0.05, 0, 0.52, 0)
PlayBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 180)
PlayBtn.BorderSizePixel = 0
PlayBtn.Text = "Play Troll Sound"
PlayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
PlayBtn.TextSize = 15
PlayBtn.Font = Enum.Font.GothamBold
PlayBtn.Parent = MainFrame

local BtnStroke = Instance.new("UIStroke")
BtnStroke.Color = Color3.fromRGB(0, 255, 255)
BtnStroke.Thickness = 1
BtnStroke.Parent = PlayBtn

local isPlaying = false

PlayBtn.MouseButton1Click:Connect(function()
    isPlaying = not isPlaying
    
    if isPlaying then
        PlayBtn.Text = "Stop Troll Sound"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            TrollSound.Parent = char.HumanoidRootPart
            TrollSound.Volume = tonumber(VolumeBox.Text) or 100
            TrollSound:Play()
        end
    else
        PlayBtn.Text = "Play Troll Sound"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 180)
        TrollSound:Stop()
    end
end)

