local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer

local ASSET_IMAGE = "rbxassetid://105816152070321"
local SOUND_ID = "8344420739"

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TsunDe1eGuiSystem"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-------------------------------------------------
-- 1. Mini Floating Icon (บังคับใช้ Asset ID 105816152070321)
-------------------------------------------------
local MiniIcon = Instance.new("ImageButton")
MiniIcon.Name = "TsunDe1eMiniIcon"
MiniIcon.Size = UDim2.new(0, 50, 0, 50)
MiniIcon.Position = UDim2.new(0.1, 0, 0.2, 0)
MiniIcon.Image = ASSET_IMAGE
MiniIcon.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MiniIcon.BorderSizePixel = 0
MiniIcon.ScaleType = Enum.ScaleType.Crop
MiniIcon.Active = true
MiniIcon.Draggable = true
MiniIcon.Parent = ScreenGui

local IconStroke = Instance.new("UIStroke")
IconStroke.Color = Color3.fromRGB(0, 255, 255)
IconStroke.Thickness = 2
IconStroke.Parent = MiniIcon

local isLocked = false
local holdTime = 0
local holdThreshold = 1.5
local holding = false

local function showBadgeNotification(statusText)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "www y.o.u.",
            Text = statusText,
            Icon = ASSET_IMAGE,
            Duration = 3
        })
    end)
end

MiniIcon.MouseButton1Down:Connect(function()
    holding = true
    holdTime = tick()
    task.delay(holdThreshold, function()
        if holding and (tick() - holdTime >= holdThreshold) then
            isLocked = not isLocked
            MiniIcon.Draggable = not isLocked
            if isLocked then
                IconStroke.Color = Color3.fromRGB(255, 50, 50)
                showBadgeNotification("Position Locked")
            else
                IconStroke.Color = Color3.fromRGB(0, 255, 255)
                showBadgeNotification("Position Unlocked")
            end
        end
    end)
end)

MiniIcon.MouseButton1Up:Connect(function()
    holding = false
end)

