targetBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        targetName = targetBox.Text
        selectedTarget = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (p.Name:lower():sub(1, #targetName) == targetName:lower() or p.DisplayName:lower():sub(1, #targetName) == targetName:lower()) then
                selectedTarget = p
                print("Target locked: " .. p.Name)
                break
            end
        end
    end
end)

