local function refreshPlayerList()
    for _, child in ipairs(dropdownFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            count = count + 1
            local pBtn = Instance.new("TextButton")
            pBtn.Parent = dropdownFrame
            pBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            pBtn.Size = UDim2.new(1, 0, 0, 24)
            pBtn.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            pBtn.Text = p.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.TextSize = 12
            
            pBtn.MouseButton1Click:Connect(function()
                selectedTarget = p
                selectTargetBtn.Text = "Target: " .. p.Name
                dropdownFrame.Visible = false
                isDropdownOpen = false
                dropdownFrame.Size = UDim2.new(0, 168, 0, 0)
            end)
        end
    end
    dropdownFrame.CanvasSize = UDim2.new(0, 0, 0, count * 26)
end

selectTargetBtn.MouseButton1Click:Connect(function()
    isDropdownOpen = not isDropdownOpen
    if isDropdownOpen then
        refreshPlayerList()
        dropdownFrame.Visible = true
        dropdownFrame.Size = UDim2.new(0, 168, 0, 100)
    else
        dropdownFrame.Visible = false
        dropdownFrame.Size = UDim2.new(0, 168, 0, 0)
    end
end)

