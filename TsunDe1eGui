local NoclipBtn = Instance.new("TextButton")
NoclipBtn.Size = UDim2.new(0.9, 0, 0, 35)
NoclipBtn.Position = UDim2.new(0.05, 0, 0, 50)
NoclipBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
NoclipBtn.Text = "Toggle Noclip: OFF"
NoclipBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
NoclipBtn.TextSize = 13
NoclipBtn.Font = Enum.Font.GothamBold
NoclipBtn.Parent = MainFrame

local NoclipStroke = Instance.new("UIStroke")
NoclipStroke.Color = Color3.fromRGB(0, 255, 255)
NoclipStroke.Thickness = 1
NoclipStroke.Parent = NoclipBtn

NoclipBtn.MouseButton1Click:Connect(function()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        NoclipBtn.Text = "Toggle Noclip: ON"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
        NoclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        noclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    else
        NoclipBtn.Text = "Toggle Noclip: OFF"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
        NoclipBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        if noclipConnection then noclipConnection:Disconnect() end
    end
end)

