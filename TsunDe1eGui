MiniIcon.MouseButton1Down:Connect(function()
    holding = true
    holdTime = tick()
    task.delay(holdThreshold, function()
        if holding and (tick() - holdTime >= holdThreshold) then
            isLocked = not isLocked
            MiniIcon.Draggable = not isLocked
            if isLocked then
                IconStroke.Color = Color3.fromRGB(255, 50, 50)
                showBadgeNotification("Position Locked")
            else
                IconStroke.Color = Color3.fromRGB(0, 255, 255)
                showBadgeNotification("Position Unlocked")
            end
        end
    end)
end)

