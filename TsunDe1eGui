local bangMode = false
local sitBangMode = false

RunService.Stepped:Connect(function()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = LocalPlayer.Character.HumanoidRootPart
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    
    if bangMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.2 + math.sin(tick() * 25) * 0.8)
    elseif sitBangMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        if humanoid then humanoid.Sit = true end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -0.5, -1 + math.sin(tick() * 25) * 0.8) * CFrame.Angles(math.rad(90), 0, 0)
    end
end)

BangBtn.MouseButton1Click:Connect(function()
    if not selectedTarget then return end
    bangMode = not bangMode
    sitBangMode = false
    SitBangBtn.Text = "Sit/Floor Bang Target: OFF"
    SitBangBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
    SitBangBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    
    if bangMode then
        BangBtn.Text = "Bang Target: ON"
        BangBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
        BangBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        BangBtn.Text = "Bang Target: OFF"
        BangBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
        BangBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    end
end)

