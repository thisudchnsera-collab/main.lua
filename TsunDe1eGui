local originalLeftShoulderC0 = nil
local originalRightShoulderC0 = nil
local originalNeckC0 = nil

local function resetJoints()
    local char = LocalPlayer.Character
    if char then
        pcall(function()
            local lShoulder = char:FindFirstChild("Left Shoulder", true) or char:FindFirstChild("LeftShoulder", true)
            local rShoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
            local neck = char:FindFirstChild("Neck", true)
            if lShoulder and originalLeftShoulderC0 then lShoulder.C0 = originalLeftShoulderC0 end
            if rShoulder and originalRightShoulderC0 then rShoulder.C0 = originalRightShoulderC0 end
            if neck and originalNeckC0 then neck.C0 = originalNeckC0 end
        end)
    end
    originalLeftShoulderC0 = nil
    originalRightShoulderC0 = nil
    originalNeckC0 = nil
end

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    local rawSpeed = tonumber(SpeedBox.Text) or 25
    local speed = math.clamp(rawSpeed, 1, 150)
    
    if bangMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.2 + math.sin(tick() * speed) * 0.8)
    elseif sitBangMode and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = selectedTarget.Character.HumanoidRootPart
        if humanoid then humanoid.Sit = true end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -0.5, -1 + math.sin(tick() * speed) * 0.8) * CFrame.Angles(math.rad(90), 0, 0)
    elseif jerkMode then
        if humanoid then humanoid.Sit = false end
        pcall(function()
            local shoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
            if shoulder then
                if not originalRightShoulderC0 then originalRightShoulderC0 = shoulder.C0 end
                shoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(90), math.rad(0), math.rad(math.sin(tick() * speed) * 60))
            end
        end)
    elseif activeTool == "CrossArms" then
        -- Tool 1: ยืนกอดอก
        pcall(function()
            local lShoulder = char:FindFirstChild("Left Shoulder", true) or char:FindFirstChild("LeftShoulder", true)
            local rShoulder = char:FindFirstChild("Right Shoulder", true) or char:FindFirstChild("RightShoulder", true)
            if lShoulder and not originalLeftShoulderC0 then originalLeftShoulderC0 = lShoulder.C0 end
            if rShoulder and not originalRightShoulderC0 then originalRightShoulderC0 = rShoulder.C0 end
            if lShoulder and rShoulder then
                lShoulder.C0 = CFrame.new(-1, 0.5, 0) * CFrame.Angles(math.rad(45), math.rad(45), math.rad(0))
                rShoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(45), math.rad(-45), math.rad(0))
            end
        end)
    elseif activeTool == "Nod" then
        -- Tool 2: พยักหน้า
        pcall(function()
            local neck = char:FindFirstChild("Neck", true)
            if neck and not originalNeckC0 then originalNeckC0 = neck.C0 end
            if neck then
                neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(90 + math.sin(tick() * 8) * 20), 0, 0)
            end
        end)
    elseif activeTool == "ShakeHead" then
        -- Tool 3: ส่ายหน้า
        pcall(function()
            local neck = char:FindFirstChild("Neck", true)
            if neck and not originalNeckC0 then originalNeckC0 = neck.C0 end
            if neck then
                neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(90), math.rad(math.sin(tick() * 8) * 30), 0)
            end
        end)
    end
end)

