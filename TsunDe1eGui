-- Noclip Loop
RunService.Stepped:Connect(function()
    if isNoclipActive and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Fixed Shift Lock Loop (Smooth camera rotation lock)
RunService.RenderStepped:Connect(function()
    if Character and HumanoidRootPart and Humanoid then
        if isShiftLockActive then
            Humanoid.AutoRotate = false
            local camCFrame = Camera.CFrame
            local targetAngle = CFrame.new(HumanoidRootPart.Position, Vector3.new(camCFrame.LookVector.X * 9999, HumanoidRootPart.Position.Y, camCFrame.LookVector.Z * 9999))
            HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position) * CFrame.Angles(0, select(2, camCFrame:ToEulerAnglesYXZ()), 0)
        else
            Humanoid.AutoRotate = true
        end
    end
end)

-- Target Handling Loop
RunService.Stepped:Connect(function()
    if Character and HumanoidRootPart then
        if selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = selectedTarget.Character.HumanoidRootPart
            if isSitPRActive then
                HumanoidRootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 3.5, 0)
            elseif isSuckActive then
                HumanoidRootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -2) * CFrame.Angles(math.rad(90), 0, 0)
            end
        end
    end
end)
